{
  "name": "ld2450-zone-card",
  "version": "0.0.0",
  "description": "Home Assistant dashboard card to draw ESPHome LD2450 polygon zones",
  "type": "module",
  "private": true,
  "license": "LGPL-2.1-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fornellas/ld2450-zone-card.git"
  },
  "scripts": {
    "build": "rollup -c",
    "watch": "rollup -c --watch",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "check": "npm run typecheck && npm run format:check && npm test && npm run build"
  },
  "dependencies": {
    "lit": "^3.3.3"
  },
  "devDependencies": {
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-replace": "^6.0.3",
    "esbuild": "^0.28.2",
    "prettier": "^3.9.9",
    "rollup": "^4.64.0",
    "rollup-plugin-esbuild": "^6.2.1",
    "typescript": "~5.9.3",
    "vitest": "^5.0.3"
  }
}
